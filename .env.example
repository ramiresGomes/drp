AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST="true"
AUTH_URL="http://127.0.0.1:43147"

# Local (docker compose): postgresql://drp:drp@127.0.0.1:5433/drp
# Supabase transaction pooler (Vercel / Next.js): porta 6543 + pgbouncer=true
DATABASE_URL="postgresql://drp:drp@127.0.0.1:5433/drp"

# Local: o mesmo valor de DATABASE_URL
# Supabase sessão/direta (migrate): porta 5432, sem pgbouncer
DIRECT_URL="postgresql://drp:drp@127.0.0.1:5433/drp"

# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth (aplicativo da Web)
# URI de redirecionamento: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Em produção o login de demonstração fica desligado.
# Use true só em staging ou na máquina local se quiser as contas @darpe.local.
AUTH_ALLOW_DEMO="true"
